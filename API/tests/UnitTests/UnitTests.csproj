        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>ProjectX.UnitTests</RootNamespace>
        <AssemblyName>ProjectX.UnitTests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
