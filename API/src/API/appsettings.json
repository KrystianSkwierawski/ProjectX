{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ProjectX;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001",
        "Certificate": {
          "Path": "",
          "Password": ""
        }
      }
    }
  },

  "JwtSettings": {
    "ValidIssuer": "ProjectX.API",
    "ValidAudience": "https://localhost:5001"
  },

  "GameSessionSettings": {
    "TicketLifetimeSeconds": 60,
    "ServerLeaseSeconds": 90
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "ProjectX": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": ".log",
          "rollingInterval": "Day"
        }
      },
      { "Name": "Console" }
    ]
  }
}
